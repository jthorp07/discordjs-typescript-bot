{
    "compilerOptions": {
      "target": "ES2022",
      "module": "CommonJS",
      "declaration": true,
      "rootDir": "./src",
      "outDir": "./bot",
      "strict": true,
      "resolveJsonModule": true,
      "esModuleInterop": true,
      "paths": {
        "@/*": ["./src/*"]
      }
    },
    "include": [
      "src/**/*"
    ],
    "exclude": [
      "node_modules",
    ],
  }